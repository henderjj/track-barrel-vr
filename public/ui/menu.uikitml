<!--
  The in-game menu (src/systems/game-menu-system.ts), opened with Y (or the
  menu button) on the left controller, or M or the Game menu button on the
  flat page. Every setting shows all its choices at once, the one in effect
  highlighted, so one press picks any of them: coat colours as swatches,
  character height as a 5 cm stepper, everything else as a row of up to four
  buttons (row-<key>-0 to -3, labelled and shown by the menu system from
  LIVE_ITEMS in src/live-settings.ts). The crew section shows only in a crew.
  Practice holds shortcuts straight to a situation worth testing, one per
  feature, so a headset check never has to play its way there (the cabin's:
  sit in either seat).
-->
<style>
  .root {
    flex-direction: column;
    width: 520px;
    padding-top: 14px;
    padding-bottom: 16px;
    padding-left: 22px;
    padding-right: 22px;
    gap: 8px;
  }

  .header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .title {
    font-size: 24px;
    font-weight: 700;
    color: #272727;
  }

  .title:dark {
    color: rgba(255, 255, 255, 0.95);
  }

  .section {
    flex-direction: column;
    gap: 6px;
  }

  .section-title {
    font-size: 13px;
    font-weight: 700;
    color: #6a6a6a;
    margin-top: 4px;
  }

  .section-title:dark {
    color: rgba(255, 255, 255, 0.55);
  }

  .hint {
    font-size: 12px;
    line-height: 1.35;
    color: #5a5a5a;
  }

  .hint:dark {
    color: rgba(255, 255, 255, 0.6);
  }

  .setting {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    min-height: 36px;
  }

  .label {
    width: 140px;
    font-size: 15px;
    color: #3a3a3a;
  }

  .label:dark {
    color: rgba(255, 255, 255, 0.85);
  }

  .choices {
    flex-direction: row;
    align-items: center;
    width: 320px;
    gap: 6px;
  }

  .choice {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    justify-content: center;
    text-align: center;
    padding-left: 4px;
    padding-right: 4px;
  }

  .swatches {
    flex-direction: row;
    align-items: center;
    width: 320px;
    gap: 4px;
  }

  .swatch {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 2px;
    padding-right: 2px;
    border-radius: 18px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    cursor: pointer;
  }

  .dot {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 14px;
  }

  .stepper {
    width: 40px;
    flex-shrink: 0;
    justify-content: center;
    text-align: center;
    font-size: 20px;
  }

  .amount {
    width: 64px;
    flex-shrink: 0;
    text-align: center;
    font-size: 16px;
    font-weight: 700;
    color: #272727;
  }

  .amount:dark {
    color: rgba(255, 255, 255, 0.95);
  }

  .own {
    width: 88px;
    flex-shrink: 0;
    justify-content: center;
    text-align: center;
  }

  .note {
    font-size: 13px;
    color: #5a5a5a;
  }

  .note:dark {
    color: rgba(255, 255, 255, 0.6);
  }

  .footer {
    flex-direction: row;
    gap: 10px;
    justify-content: center;
  }

  .wide {
    width: 220px;
  }
</style>
<Panel id="menu-root" class="root">
  <div class="header">
    <div class="title">Settings</div>
    <Button id="menu-close" size="sm" variant="secondary">Close</Button>
  </div>
  <Divider></Divider>

  <div id="menu-crew" class="section" style="display: none">
    <div class="section-title">CREW</div>
    <div id="menu-crew-status" class="hint">Crew</div>
    <div id="row-mic" class="setting">
      <div id="row-mic-label" class="label">My microphone</div>
      <div id="row-mic-choices" class="choices">
        <Button id="row-mic-0" class="choice" size="sm" variant="secondary">On</Button>
        <Button id="row-mic-1" class="choice" size="sm" variant="secondary">Muted</Button>
        <div id="row-mic-note" class="note" style="display: none">Off</div>
      </div>
    </div>
    <div id="row-crew" class="setting">
      <div id="row-crew-label" class="label">Crewmate's voice</div>
      <div id="row-crew-choices" class="choices">
        <Button id="row-crew-0" class="choice" size="sm" variant="secondary">On</Button>
        <Button id="row-crew-1" class="choice" size="sm" variant="secondary">Muted</Button>
      </div>
    </div>
  </div>

  <div class="section">
    <div class="section-title">YOU</div>
    <div class="setting">
      <div class="label">Coat colour</div>
      <div class="swatches">
        <div id="coat-0" class="swatch"><div id="coat-0-dot" class="dot"></div></div>
        <div id="coat-1" class="swatch"><div id="coat-1-dot" class="dot"></div></div>
        <div id="coat-2" class="swatch"><div id="coat-2-dot" class="dot"></div></div>
        <div id="coat-3" class="swatch"><div id="coat-3-dot" class="dot"></div></div>
        <div id="coat-4" class="swatch"><div id="coat-4-dot" class="dot"></div></div>
        <div id="coat-5" class="swatch"><div id="coat-5-dot" class="dot"></div></div>
        <div id="coat-6" class="swatch"><div id="coat-6-dot" class="dot"></div></div>
        <div id="coat-7" class="swatch"><div id="coat-7-dot" class="dot"></div></div>
      </div>
    </div>
    <div id="row-seated" class="setting">
      <div id="row-seated-label" class="label">Playing</div>
      <div id="row-seated-choices" class="choices">
        <Button id="row-seated-0" class="choice" size="sm" variant="secondary">Standing</Button>
        <Button id="row-seated-1" class="choice" size="sm" variant="secondary">Seated</Button>
      </div>
    </div>
    <div class="setting">
      <div class="label">Character height</div>
      <div class="choices">
        <Button id="height-down" class="stepper" size="sm" variant="secondary">-</Button>
        <div id="height-value" class="amount">-</div>
        <Button id="height-up" class="stepper" size="sm" variant="secondary">+</Button>
        <Button id="height-own" class="own" size="sm" variant="secondary">Your own</Button>
      </div>
    </div>
    <div class="setting">
      <div class="label">Seat</div>
      <div class="choices">
        <Button id="menu-reseat" class="choice" size="sm" variant="secondary">Back in my seat</Button>
      </div>
    </div>
  </div>

  <div class="section">
    <div class="section-title">SOUND AND VIEW</div>
    <div id="row-hud" class="setting">
      <div id="row-hud-label" class="label">Setting</div>
      <div id="row-hud-choices" class="choices">
        <Button id="row-hud-0" class="choice" size="sm" variant="secondary">Choice</Button>
        <Button id="row-hud-1" class="choice" size="sm" variant="secondary">Choice</Button>
        <Button id="row-hud-2" class="choice" size="sm" variant="secondary">Choice</Button>
        <Button id="row-hud-3" class="choice" size="sm" variant="secondary">Choice</Button>
      </div>
    </div>
    <div id="row-hz" class="setting">
      <div id="row-hz-label" class="label">Setting</div>
      <div id="row-hz-choices" class="choices">
        <Button id="row-hz-0" class="choice" size="sm" variant="secondary">Choice</Button>
        <Button id="row-hz-1" class="choice" size="sm" variant="secondary">Choice</Button>
        <Button id="row-hz-2" class="choice" size="sm" variant="secondary">Choice</Button>
        <Button id="row-hz-3" class="choice" size="sm" variant="secondary">Choice</Button>
      </div>
    </div>
    <div id="row-foveation" class="setting">
      <div id="row-foveation-label" class="label">Setting</div>
      <div id="row-foveation-choices" class="choices">
        <Button id="row-foveation-0" class="choice" size="sm" variant="secondary">Choice</Button>
        <Button id="row-foveation-1" class="choice" size="sm" variant="secondary">Choice</Button>
        <Button id="row-foveation-2" class="choice" size="sm" variant="secondary">Choice</Button>
        <Button id="row-foveation-3" class="choice" size="sm" variant="secondary">Choice</Button>
      </div>
    </div>
  </div>
  <div id="menu-ride" class="section" style="display: none">
    <div class="section-title">RIDING (SPIKE S2)</div>
    <div id="menu-ride-status" class="hint">Riding</div>
    <div id="row-ride-vignette" class="setting">
      <div id="row-ride-vignette-label" class="label">Vignette</div>
      <div class="choices">
        <Button id="row-ride-vignette-0" class="choice" size="sm" variant="secondary">On</Button>
        <Button id="row-ride-vignette-1" class="choice" size="sm" variant="secondary">Off</Button>
      </div>
    </div>
    <div id="row-ride-cabin" class="setting">
      <div id="row-ride-cabin-label" class="label">Cabin</div>
      <div class="choices">
        <Button id="row-ride-cabin-0" class="choice" size="sm" variant="secondary">Open top</Button>
        <Button id="row-ride-cabin-1" class="choice" size="sm" variant="secondary">Closed</Button>
      </div>
    </div>
    <div id="row-ride-tank" class="setting">
      <div id="row-ride-tank-label" class="label">Driven by</div>
      <div class="choices">
        <Button id="row-ride-tank-0" class="choice" size="sm" variant="secondary">Crewmate</Button>
        <Button id="row-ride-tank-1" class="choice" size="sm" variant="secondary">Left stick</Button>
        <Button id="row-ride-tank-2" class="choice" size="sm" variant="secondary">Parked</Button>
      </div>
    </div>
    <div id="row-ride-turret" class="setting">
      <div id="row-ride-turret-label" class="label">Turret</div>
      <div class="choices">
        <Button id="row-ride-turret-0" class="choice" size="sm" variant="secondary">Crewmate</Button>
        <Button id="row-ride-turret-1" class="choice" size="sm" variant="secondary">Right stick</Button>
        <Button id="row-ride-turret-2" class="choice" size="sm" variant="secondary">Still</Button>
      </div>
    </div>
  </div>
  <div class="section">
    <div class="section-title">PRACTICE</div>
    <div id="row-seat" class="setting">
      <div id="row-seat-label" class="label">Sit in</div>
      <div id="row-seat-choices" class="choices">
        <Button id="row-seat-0" class="choice" size="sm" variant="secondary">Driver</Button>
        <Button id="row-seat-1" class="choice" size="sm" variant="secondary">Gunner</Button>
      </div>
    </div>
    <div class="setting">
      <div class="label">Ride the tank</div>
      <div class="choices">
        <Button id="menu-ride-driver" class="choice" size="sm" variant="secondary">As driver</Button>
        <Button id="menu-ride-gunner" class="choice" size="sm" variant="secondary">As gunner</Button>
        <Button id="menu-ride-stop" class="choice" size="sm" variant="secondary" style="display: none">Stop</Button>
      </div>
    </div>
    <div class="setting">
      <div class="label">Gunsight (S1)</div>
      <div class="choices">
        <Button id="menu-sight-go" class="choice" size="sm" variant="secondary">Go to it</Button>
        <Button id="menu-sight-aim" class="choice" size="sm" variant="secondary">Aim ahead</Button>
      </div>
    </div>
    <div class="setting">
      <div class="label">Sight render</div>
      <div class="choices">
        <Button id="menu-sight-draw" class="choice" size="sm" variant="secondary">Draw: near</Button>
        <Button id="menu-sight-size" class="choice" size="sm" variant="secondary">512²</Button>
        <Button id="menu-sight-eye" class="choice" size="sm" variant="secondary">Both eyes</Button>
      </div>
    </div>
    <div class="setting">
      <div class="label">Loading (S4)</div>
      <div class="choices">
        <Button id="menu-loading" class="choice" size="sm" variant="secondary">Sit at the breech</Button>
      </div>
    </div>
    <div class="setting">
      <div class="label">Lever test</div>
      <div class="choices">
        <Button id="menu-levers" class="choice" size="sm" variant="secondary">In front of me</Button>
        <Button id="menu-levers-away" class="choice" size="sm" variant="secondary">Put away</Button>
      </div>
    </div>
  </div>
  <Divider></Divider>

  <div class="footer">
    <Button id="menu-start" class="wide" variant="secondary">Back to start screen</Button>
    <Button id="menu-exit" class="wide" variant="negative">Exit VR</Button>
  </div>
  <div id="menu-hint" class="hint">Y or B: close. X: perf HUD.</div>
</Panel>
