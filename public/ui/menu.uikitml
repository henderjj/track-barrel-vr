<!--
  The in-game menu (src/systems/game-menu-system.ts), opened with Y (or the
  menu button) on the left controller, or M or the Game menu button on the
  flat page. Its settings are grouped into tabs down the left (tab-<name>),
  each showing one page (page-<name>, listed in MENU_TABS in
  src/game-flow.ts); the pages area keeps one height so the panel doesn't
  jump as the tabs change. Every setting shows all its choices at once, the
  one in effect highlighted, so one press picks any of them: coat colours as
  swatches, eye height as a 5 cm stepper, everything else as a row of up to
  four buttons (row-<key>-0 to -3, labelled and shown by the menu system from
  LIVE_ITEMS in src/live-settings.ts).

  - Crew (the tab shows only in a crew): microphone and the crewmate's voice,
    and Calls, which sends the crewmate a call for the other seat, shown on
    their sign and obeyed by the practice crewmate (F1.13): to the driver
    from the gunner's seat, to the gunner from the driver's.
  - You: coat, standing or seated, eye height, Seat (back in it, or swap,
    in a crew once the crewmate agrees) and Calibration (eyes and reach again).
  - Comfort (F1.14): the vignette's strength and reduced bumps, a mark for
    the moment the player feels queasy, and the play-test stats CSV.
  - Sound and view: the other live settings.
  - Tank: the drive's state and gearbox, the range's state, and spike
    S2's ride options while riding.
  - Practice, Sights and Test rigs hold shortcuts straight to a situation
    worth testing, one per feature, so a headset check never has to play its
    way there. Practice: sit in either seat; drive, or put the tank back at
    its start; lay the gun, or turn the turret forward; load and fire as
    gunner; play each of the tank's short sounds; park up the range facing a
    target; start or stop a range run, and ready to fire on each target,
    parked at the start, laid and loaded. Sights: go to the gunsight, lay the
    gun on a target's range mark, the sight's render choices; go to the
    periscope, turn it ahead, its power. Test rigs: ride the tank (spike
    S2), the lever test and the mechanism kit.
-->
<style>
  .root {
    flex-direction: column;
    width: 672px;
    padding-top: 14px;
    padding-bottom: 16px;
    padding-left: 22px;
    padding-right: 22px;
    gap: 8px;
  }

  .header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .title {
    font-size: 24px;
    font-weight: 700;
    color: #272727;
  }

  .title:dark {
    color: rgba(255, 255, 255, 0.95);
  }

  .body {
    flex-direction: row;
    gap: 16px;
  }

  .tabs {
    flex-direction: column;
    flex-shrink: 0;
    width: 136px;
    gap: 6px;
    padding-top: 4px;
  }

  .tab {
    justify-content: flex-start;
  }

  .pages {
    flex-direction: column;
    flex-shrink: 0;
    width: 476px;
    min-height: 424px;
  }

  .page {
    flex-direction: column;
    gap: 8px;
  }

  .section {
    flex-direction: column;
    gap: 6px;
  }

  .section-title {
    font-size: 13px;
    font-weight: 700;
    color: #6a6a6a;
    margin-top: 4px;
  }

  .section-title:dark {
    color: rgba(255, 255, 255, 0.55);
  }

  .hint {
    font-size: 12px;
    line-height: 1.35;
    color: #5a5a5a;
  }

  .hint:dark {
    color: rgba(255, 255, 255, 0.6);
  }

  .setting {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    min-height: 36px;
  }

  .label {
    width: 140px;
    font-size: 15px;
    color: #3a3a3a;
  }

  .label:dark {
    color: rgba(255, 255, 255, 0.85);
  }

  .choices {
    flex-direction: row;
    align-items: center;
    width: 320px;
    gap: 6px;
  }

  .choice {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    justify-content: center;
    text-align: center;
    padding-left: 4px;
    padding-right: 4px;
  }

  .swatches {
    flex-direction: row;
    align-items: center;
    width: 320px;
    gap: 4px;
  }

  .swatch {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 2px;
    padding-right: 2px;
    border-radius: 18px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    cursor: pointer;
  }

  .dot {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 14px;
  }

  .stepper {
    width: 40px;
    flex-shrink: 0;
    justify-content: center;
    text-align: center;
    font-size: 20px;
  }

  .amount {
    width: 64px;
    flex-shrink: 0;
    text-align: center;
    font-size: 16px;
    font-weight: 700;
    color: #272727;
  }

  .amount:dark {
    color: rgba(255, 255, 255, 0.95);
  }

  .own {
    width: 88px;
    flex-shrink: 0;
    justify-content: center;
    text-align: center;
  }

  .note {
    font-size: 13px;
    color: #5a5a5a;
  }

  .note:dark {
    color: rgba(255, 255, 255, 0.6);
  }

  .footer {
    flex-direction: row;
    gap: 10px;
    justify-content: center;
  }

  .wide {
    width: 220px;
  }
</style>
<Panel id="menu-root" class="root">
  <div class="header">
    <div class="title">Settings</div>
    <Button id="menu-close" size="sm" variant="secondary">Close</Button>
  </div>
  <Divider></Divider>

  <div class="body">
    <div class="tabs">
      <Button id="tab-crew" class="tab" size="sm" variant="secondary" style="display: none">Crew</Button>
      <Button id="tab-you" class="tab" size="sm" variant="secondary">You</Button>
      <Button id="tab-comfort" class="tab" size="sm" variant="secondary">Comfort</Button>
      <Button id="tab-view" class="tab" size="sm" variant="secondary">Sound and view</Button>
      <Button id="tab-tank" class="tab" size="sm" variant="secondary">Tank</Button>
      <Button id="tab-practice" class="tab" size="sm" variant="secondary">Practice</Button>
      <Button id="tab-sights" class="tab" size="sm" variant="secondary">Sights</Button>
      <Button id="tab-rigs" class="tab" size="sm" variant="secondary">Test rigs</Button>
    </div>
    <div class="pages">
      <div id="page-crew" class="page" style="display: none">
        <div id="menu-crew" class="section" style="display: none">
          <div id="menu-crew-status" class="hint">Crew</div>
          <div id="row-mic" class="setting">
            <div id="row-mic-label" class="label">My microphone</div>
            <div id="row-mic-choices" class="choices">
              <Button id="row-mic-0" class="choice" size="sm" variant="secondary">On</Button>
              <Button id="row-mic-1" class="choice" size="sm" variant="secondary">Muted</Button>
              <div id="row-mic-note" class="note" style="display: none">Off</div>
            </div>
          </div>
          <div id="row-crew" class="setting">
            <div id="row-crew-label" class="label">Crewmate's voice</div>
            <div id="row-crew-choices" class="choices">
              <Button id="row-crew-0" class="choice" size="sm" variant="secondary">On</Button>
              <Button id="row-crew-1" class="choice" size="sm" variant="secondary">Muted</Button>
            </div>
          </div>
        </div>
        <div id="menu-calls" class="section" style="display: none">
          <div class="section-title">CALLS</div>
          <div id="menu-calls-status" class="hint">Calls</div>
          <div id="row-calls-drive" class="setting">
            <div class="label">Driver</div>
            <div class="choices">
              <Button id="call-advance" class="choice" size="sm" variant="secondary">Advance</Button>
              <Button id="call-halt" class="choice" size="sm" variant="secondary">Halt</Button>
              <Button id="call-reverse" class="choice" size="sm" variant="secondary">Reverse</Button>
            </div>
          </div>
          <div id="row-calls-turn" class="setting">
            <div class="label">Driver</div>
            <div class="choices">
              <Button id="call-left" class="choice" size="sm" variant="secondary">Left</Button>
              <Button id="call-right" class="choice" size="sm" variant="secondary">Right</Button>
              <Button id="call-route" class="choice" size="sm" variant="secondary">Route</Button>
            </div>
          </div>
          <div id="row-calls-gun" class="setting">
            <div class="label">Gunner</div>
            <div class="choices">
              <Button id="call-fire" class="choice" size="sm" variant="secondary">Fire at will</Button>
              <Button id="call-hold" class="choice" size="sm" variant="secondary">Hold fire</Button>
            </div>
          </div>
        </div>
      </div>
      <div id="page-you" class="page">
        <div class="section">
          <div class="setting">
            <div class="label">Coat colour</div>
            <div class="swatches">
              <div id="coat-0" class="swatch"><div id="coat-0-dot" class="dot"></div></div>
              <div id="coat-1" class="swatch"><div id="coat-1-dot" class="dot"></div></div>
              <div id="coat-2" class="swatch"><div id="coat-2-dot" class="dot"></div></div>
              <div id="coat-3" class="swatch"><div id="coat-3-dot" class="dot"></div></div>
              <div id="coat-4" class="swatch"><div id="coat-4-dot" class="dot"></div></div>
              <div id="coat-5" class="swatch"><div id="coat-5-dot" class="dot"></div></div>
              <div id="coat-6" class="swatch"><div id="coat-6-dot" class="dot"></div></div>
              <div id="coat-7" class="swatch"><div id="coat-7-dot" class="dot"></div></div>
            </div>
          </div>
          <div id="row-seated" class="setting">
            <div id="row-seated-label" class="label">Playing</div>
            <div id="row-seated-choices" class="choices">
              <Button id="row-seated-0" class="choice" size="sm" variant="secondary">Standing</Button>
              <Button id="row-seated-1" class="choice" size="sm" variant="secondary">Seated</Button>
            </div>
          </div>
          <div class="setting">
            <div class="label">Eye height</div>
