            <div id="row-vignette-choices" class="choices">
              <Button id="row-vignette-0" class="choice" size="sm" variant="secondary">Choice</Button>
              <Button id="row-vignette-1" class="choice" size="sm" variant="secondary">Choice</Button>
              <Button id="row-vignette-2" class="choice" size="sm" variant="secondary">Choice</Button>
              <Button id="row-vignette-3" class="choice" size="sm" variant="secondary">Choice</Button>
            </div>
          </div>
          <div id="row-bumps" class="setting">
